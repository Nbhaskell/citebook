# Copy to .env and edit. Blank values use the defaults in citebook/config.py.
# Settings are added here as each phase creates them (docs/TRD.md section 12).

CITEBOOK_PORT=
CITEBOOK_DB_PATH=
# ollama (default) or hosted. Hosted also needs CITEBOOK_ALLOW_HOSTED=true.
CITEBOOK_MODEL_PROVIDER=
OLLAMA_URL=
CITEBOOK_MODEL=
CITEBOOK_KB_URL=
# fake (default) or rag_project. rag_project needs rag-project's POST /api/search.
CITEBOOK_KB=
# true turns on the model's thinking (slower).
CITEBOOK_ENABLE_THINKING=
CITEBOOK_MAX_TOOL_CALLS_PER_TURN=
CITEBOOK_MAX_CONSECUTIVE_REFUSALS=
CITEBOOK_TURN_TIMEOUT_S=
CITEBOOK_ALLOW_HOSTED=
CITEBOOK_SYNTHETIC_DATA=
# Evaluation only. The API refuses any value other than "none" unless CITEBOOK_EVAL=true.
CITEBOOK_ABLATION=
CITEBOOK_EVAL=
