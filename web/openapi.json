{
  "components": {
    "schemas": {
      "Ablation": {
        "enum": [
          "none",
          "baseline",
          "no_least_privilege",
          "no_gate_policy",
          "no_data_marking",
          "no_reply_checks",
          "no_screening"
        ],
        "title": "Ablation",
        "type": "string"
      },
      "CancelOut": {
        "properties": {
          "outcome": {
            "title": "Outcome",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "outcome",
          "status"
        ],
        "title": "CancelOut",
        "type": "object"
      },
      "CardOut": {
        "properties": {
          "action_id": {
            "title": "Action Id",
            "type": "string"
          },
          "action_type": {
            "title": "Action Type",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "payload_hash": {
            "title": "Payload Hash",
            "type": "string"
          },
          "rows": {
            "items": {
              "type": "string"
            },
            "title": "Rows",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "action_id",
          "action_type",
          "title",
          "rows",
          "payload_hash",
          "expires_at"
        ],
        "title": "CardOut",
        "type": "object"
      },
      "ConfirmIn": {
        "properties": {
          "payload_hash": {
            "maxLength": 64,
            "minLength": 64,
            "title": "Payload Hash",
            "type": "string"
          }
        },
        "required": [
          "payload_hash"
        ],
        "title": "ConfirmIn",
        "type": "object"
      },
      "ConfirmOut": {
        "properties": {
          "booking_reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Booking Reference"
          },
          "outcome": {
            "title": "Outcome",
            "type": "string"
          },
          "reply": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReplyOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "outcome",
          "booking_reference",
          "reply",
          "status"
        ],
        "title": "ConfirmOut",
        "type": "object"
      },
      "ConversationCreated": {
        "properties": {
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "session_token": {
            "title": "Session Token",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "synthetic_data": {
            "title": "Synthetic Data",
            "type": "boolean"
          }
        },
        "required": [
          "conversation_id",
          "session_token",
          "status",
          "synthetic_data"
        ],
        "title": "ConversationCreated",
        "type": "object"
      },
      "CustomerMessage": {
        "properties": {
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "CustomerMessage",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "NewConversation": {
        "properties": {
          "channel": {
            "default": "web_widget",
            "enum": [
              "web_widget",
              "simulator"
            ],
            "title": "Channel",
            "type": "string"
          }
        },
        "title": "NewConversation",
        "type": "object"
      },
      "ReplyOut": {
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "text"
        ],
        "title": "ReplyOut",
        "type": "object"
      },
      "Status": {
        "description": "What the service can say about itself. `None` means \"not checked yet\": the parts that\nwould be checked (model, knowledge base, database) are built in later phases.",
        "properties": {
          "ablation": {
            "$ref": "#/components/schemas/Ablation"
          },
          "database": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Database"
          },
          "kb_reachable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kb Reachable"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "model_reachable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Reachable"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "synthetic_data": {
            "title": "Synthetic Data",
            "type": "boolean"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version",
          "provider",
          "model",
          "synthetic_data",
          "ablation",
          "model_reachable",
          "kb_reachable",
          "database"
        ],
        "title": "Status",
        "type": "object"
      },
      "TurnOut": {
        "properties": {
          "card": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CardOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "replies": {
            "items": {
              "$ref": "#/components/schemas/ReplyOut"
            },
            "title": "Replies",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "replies",
          "card",
          "status"
        ],
        "title": "TurnOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Citebook API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/actions/{action_id}/cancel": {
      "post": {
        "operationId": "press_cancel_api_actions__action_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "action_id",
            "required": true,
            "schema": {
              "title": "Action Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Session-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Session-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Press Cancel"
      }
    },
